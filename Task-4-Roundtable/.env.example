# Copy this file to .env and fill in the blanks before running docker compose.

POSTGRES_USER=roundtable
# Avoid characters that need escaping in a URL (@ : / ? # %), because
# docker-compose.yml builds DATABASE_URL out of this value.
POSTGRES_PASSWORD=
POSTGRES_DB=roundtabledb

# Only needed when running the app outside Docker, against your own Postgres.
# Under docker compose the app service composes DATABASE_URL from the three
# values above, so leave this commented out.
# DATABASE_URL=postgresql://roundtable:your-password@localhost:5432/roundtabledb

# Signs the session cookie. Generate with: openssl rand -hex 32
JWT_SECRET=

PORT=4003

# --- ICE ---------------------------------------------------------------------
# STUN tells a browser its own public address. That is enough on most home and
# office networks. Comma separated; the default below is used if left blank.
# STUN_URLS=stun:stun.l.google.com:19302

# TURN relays the media when the two browsers cannot reach each other directly,
# which is the case behind symmetric NAT or a corporate firewall. It needs
# credentials, so it cannot be expressed as another STUN_URLS entry. All three
# have to be set together or the entry is ignored.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Deployment --------------------------------------------------------------
# Set when the app runs behind a TLS terminator or reverse proxy, so req.ip is
# the caller rather than the proxy. A number is a hop count; anything else is
# treated as a list of trusted addresses.
# TRUST_PROXY=1
