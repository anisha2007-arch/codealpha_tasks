# Copy this file to .env and fill in the blanks before running docker compose.

POSTGRES_USER=sightline
# Avoid characters that need escaping in a URL (@ : / ? # %), because
# docker-compose.yml builds DATABASE_URL out of this value.
POSTGRES_PASSWORD=
POSTGRES_DB=sightlinedb

# Only needed when running the app outside Docker, against your own Postgres.
# Under docker compose the app service composes DATABASE_URL from the three
# values above, so leave this commented out.
# DATABASE_URL=postgresql://sightline:your-password@localhost:5432/sightlinedb

# Signs the session cookie. Generate with: openssl rand -hex 32
JWT_SECRET=

PORT=4002
